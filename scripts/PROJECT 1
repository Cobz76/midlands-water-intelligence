import os
from reportlab.lib.pagesizes import letter
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Preformatted
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.enums import TA_CENTER, TA_LEFT
from reportlab.lib import colors

def generate_pdf_documentation():
    pdf_path = r"C:\Users\markc\Documents\Data Science\Water_Pipeline_Documentation.pdf"
    print("[*] Initialising PDF generation engine...")
    
    # 1. Setup Document Template Architecture
    doc = SimpleDocTemplate(
        pdf_path,
        pagesize=letter,
        rightMargin=54, leftMargin=54,
        topMargin=54, bottomMargin=54
    )
    
    # 2. Configure Professional Typographic Styles
    styles = getSampleStyleSheet()
    
    title_style = ParagraphStyle(
        'DocTitle',
        parent=styles['Heading1'],
        fontName='Helvetica-Bold',
        fontSize=24,
        leading=28,
        textColor=colors.HexColor('#1A365D'), # Deep Navy
        alignment=TA_LEFT,
        spaceAfter=15
    )
    
    h1_style = ParagraphStyle(
        'DocH1',
        parent=styles['Heading2'],
        fontName='Helvetica-Bold',
        fontSize=16,
        leading=20,
        textColor=colors.HexColor('#2B6CB0'), # Slate Blue
        spaceBefore=18,
        spaceAfter=10,
        keepWithNext=True
    )
    
    h2_style = ParagraphStyle(
        'DocH2',
        parent=styles['Heading3'],
        fontName='Helvetica-Bold',
        fontSize=12,
        leading=16,
        textColor=colors.HexColor('#2D3748'), # Charcoal
        spaceBefore=12,
        spaceAfter=6,
        keepWithNext=True
    )
    
    body_style = ParagraphStyle(
        'DocBody',
        parent=styles['Normal'],
        fontName='Helvetica',
        fontSize=10.5,
        leading=15,
        textColor=colors.HexColor('#2D3748'),
        spaceAfter=8
    )
    
    code_style = ParagraphStyle(
        'DocCode',
        fontName='Courier',
        fontSize=8.5,
        leading=11,
        textColor=colors.HexColor('#1A202C'),
        backColor=colors.HexColor('#EDF2F7'), # Soft Grey Canvas
        borderColor=colors.HexColor('#CBD5E0'),
        borderWidth=0.5,
        borderPadding=8,
        spaceBefore=8,
        spaceAfter=8
    )

    story = []

    # --- COVER SECTION ---
    story.append(Paragraph("Technical Documentation: Environmental Intelligence Pipeline", title_style))
    story.append(Paragraph("<b>Project Focus:</b> Midlands Water Ingestion, Filtration & GIS Mapping Platform", body_style))
    story.append(Paragraph("<b>Primary Architecture Root:</b> C:\\Users\\markc\\Documents\\Data Science", body_style))
    story.append(Spacer(1, 15))
    
    # --- PART 1 ---
    story.append(Paragraph("Part 1: Conversation History & Technical Diagnoses", h1_style))
    
    story.append(Paragraph("1. Python Execution & Indentation Frameworks", h2_style))
    story.append(Paragraph("During system iteration, standard conversational conversational chat notes were inadvertently appended to the raw source script, producing structural SyntaxErrors. Subsequent formatting updates encountered IndentationErrors due to whitespace alignment issues under Python's execution scope definitions. Moving block operations out of global execution into dedicated, named functions successfully isolated the processing states.", body_style))
    
    story.append(Paragraph("2. The Spatial Projection Paradox (The Missing Canvas Map)", h2_style))
    story.append(Paragraph("When importing data arrays into QGIS layout contexts, coordinates mapped onto grid matrices successfully, but background tile services rendered as completely blank workspaces. The ingestion pipeline tracks positions in geographic decimal <b>degrees</b> (WGS 84). QGIS initially interpreted these values as metric variables (meters) inside its active Web Mercator projection environment (EPSG:3857). This scale mismatch pushed coordinates out to an ocean grid off the coast of Scotland. Adjusting the geometry engine parameters to explicitly process <b>EPSG:4326</b> resolved the data alignment problem.", body_style))
    
    # --- PART 2 ---
    story.append(Paragraph("Part 2: Production Script Deployments", h1_style))
    
    # Core Script Code
    story.append(Paragraph("Asset A: Core ETL Engine and Mapping Stack (PROJECT 1)", h2_style))
    code_a = '''import os, sqlite3\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nDATA_DIR = r"C:\\Users\\markc\\Documents\\Data Science"\nRAW_DATA_PATH = r"C:\\Users\\markc\\Documents\\Data Science\\midlands_water_raw.csv"\nDB_PATH = r"C:\\Users\\markc\\Documents\\Data Science\\midlands_water.db"\n\ndef run_etl():\n    if not os.path.exists(DATA_DIR): os.makedirs(DATA_DIR)\n    df = pd.read_csv(RAW_DATA_PATH, usecols=['id','phenomenonTime','determinand.prefLabel','result','samplingPoint.longitude','samplingPoint.latitude'])\n    df = df.dropna(subset=['phenomenonTime', 'result', 'samplingPoint.longitude', 'samplingPoint.latitude'])\n    filtered_df = df[df['determinand.prefLabel'].str.contains('Ammoniacal Nitrogen|Oxygen Demand', case=False, na=False)].copy()\n    \n    conn = sqlite3.connect(DB_PATH)\n    db_ready = filtered_df.rename(columns={'determinand.prefLabel': 'determinand_prefLabel', 'samplingPoint.longitude': 'longitude', 'samplingPoint.latitude': 'latitude'})\n    db_ready.to_sql('water_anomalies', conn, if_exists='replace', index=False)\n    conn.close()\n    print("[+] Ingestion & Database Commit Complete.")'''
    story.append(Preformatted(code_a, code_style))
    
    # Google Earth Code
    story.append(Paragraph("Asset B: Google Earth KML Transformation Script", h2_style))
    code_b = '''import sqlite3\nimport geopandas as gpd\nfrom shapely.geometry import Point\n\nconn = sqlite3.connect(r"C:\\Users\\markc\\Documents\\Data Science\\midlands_water.db")\ndf = pd.read_sql_query("SELECT * FROM water_anomalies", conn)\nconn.close()\n\ngeometry = [Point(xy) for xy in zip(df['longitude'], df['latitude'])]\ngdf = gpd.GeoDataFrame(df, geometry=geometry, crs="EPSG:4326")\ngdf.to_file(r"C:\\Users\\markc\\Documents\\Data Science\\midlands_anomalies.kml", driver="KML")\nprint("[+] Google Earth Vector KML Created Sucessfully.")'''
    story.append(Preformatted(code_b, code_style))

    # --- PART 3 ---
    story.append(Paragraph("Part 3: Spatial Software Workspace Workflows", h1_style))
    story.append(Paragraph("To assemble these assets cleanly into QGIS workspaces without system network lag or rendering freezes, execute the following direct workflow:", body_style))
    story.append(Paragraph("<b>1. Data Mount:</b> Select <i>Layer -> Add Layer -> Add Delimited Text Layer</i>.", body_style))
    story.append(Paragraph("<b>2. Coordinate Rules:</b> Link X to longitude, Y to latitude, and choose <b>EPSG:4326 - WGS 84</b> as the Geometry CRS.", body_style))
    story.append(Paragraph("<b>3. Map Underlay:</b> Pull a clean web tiles map from <i>XYZ Tiles</i>, dropping it to the absolute bottom of the Layers index table.", body_style))
    
    # Build Document
    doc.build(story)
    print(f"[+] PDF Document Compiled and Verified! Locked at: {pdf_path}")

if __name__ == "__main__":
