"""
Environmental Intelligence Pipeline - Ingestion & Anomaly Isolation Engine
Target Dataset: UK Environment Agency Water Quality Archive (Modern API Layout)
"""

import os
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

# Hardcoded Local Architecture Constants
DATA_DIR = r"C:\Users\markc\Documents\Data Science"
RAW_DATA_PATH = r"C:\Users\markc\Documents\Data Science\midlands_water_raw.csv"
DB_PATH = r"C:\Users\markc\Documents\Data Science\midlands_water.db"

# Strict Regulatory Thresholds (mg/L)
AMMONIA_MAX_ALLOWED = 0.5  
BOD_MAX_ALLOWED = 50.0      

def validate_environment():
    """Verify local folder structural health prior to running pipeline."""
    if not os.path.exists(DATA_DIR):
        os.makedirs(DATA_DIR)
        print(f"[+] Created missing root directory: {DATA_DIR}")
    if not os.path.exists(RAW_DATA_PATH):
        raise FileNotFoundError(
            f"CRITICAL: Raw source file missing at {RAW_DATA_PATH}. "
            "Download dataset before executing."
        )

def run_etl():
    """Executes the ingestion, filtration, and database loading process."""
    validate_environment()
    print("[*] Launching ETL Core Engine...")
    
    target_columns = [
        'id', 'phenomenonTime', 'determinand.prefLabel', 
        'result', 'samplingPoint.longitude', 'samplingPoint.latitude'
    ]
    
    print("[*] Phase 1/5: Loading Raw Records into Memory...")
    try:
        df = pd.read_csv(RAW_DATA_PATH, usecols=target_columns, low_memory=False)
    except Exception as e:
        print(f"[-] Data Ingestion Failed: {str(e)}")
        return

    print("[*] Phase 2/5: Normalising Data Fields & Cleaning Text...")
    df['phenomenonTime'] = pd.to_datetime(df['phenomenonTime'], errors='coerce')
    df['result'] = pd.to_numeric(df['result'], errors='coerce')
    
    initial_count = len(df)
    df = df.dropna(subset=['phenomenonTime', 'result', 'samplingPoint.longitude', 'samplingPoint.latitude'])
    print(f"[+] Dropped {initial_count - len(df)} records with missing geospatial/analytical coordinates.")

    print("[*] Phase 3/5: Running Filtration Matrices...")
    filtered_df = df[
        df['determinand.prefLabel'].str.contains('Ammoniacal Nitrogen|Oxygen Demand', case=False, na=False)
    ].copy()

    print("[*] Phase 4/5: Isolating Systemic Outliers...")
    is_ammonia_spike = (filtered_df['determinand.prefLabel'].str.contains('Ammoniacal', case=False)) & (filtered_df['result'] > AMMONIA_MAX_ALLOWED)
    is_bod_spike = (filtered_df['determinand.prefLabel'].str.contains('Oxygen', case=False)) & (filtered_df['result'] > BOD_MAX_ALLOWED)
    
    anomalies = filtered_df[is_ammonia_spike | is_bod_spike].copy()
    print(f"[+] Isolated {len(anomalies)} priority contamination anomalies.")

    print("[*] Phase 5/5: Loading Anomalies into Secure SQLite Repository...")
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("DROP TABLE IF EXISTS water_anomalies")
    cursor.execute("""
        CREATE TABLE water_anomalies (
            id TEXT PRIMARY KEY,
            phenomenonTime TEXT,
            determinand_prefLabel TEXT,
            result REAL,
            longitude REAL,
            latitude REAL
        )
    """)
    
    db_ready_df = anomalies.rename(columns={
        'determinand.prefLabel': 'determinand_prefLabel',
        'samplingPoint.longitude': 'longitude',
        'samplingPoint.latitude': 'latitude'
    })
    
    db_ready_df.to_sql('water_anomalies', conn, if_exists='append', index=False)
    cursor.execute("CREATE INDEX idx_coords ON water_anomalies(longitude, latitude)")
    cursor.execute("CREATE INDEX idx_determinands ON water_anomalies(determinand_prefLabel)")
    
    conn.commit()
    conn.close()
    print(f"[+] Database Writing Complete. Secure File Locked at: {DB_PATH}")


def check_results():
    """Queries the database and prints out terminal logs for the top 5 anomalies."""
    print("\n=== QUERYING TOP 5 CONTAMINATION ANOMALIES ===")
    conn = sqlite3.connect(DB_PATH)
    query = "SELECT * FROM water_anomalies ORDER BY result DESC LIMIT 5"
    top_anomalies = pd.read_sql_query(query, conn)
    conn.close()
    print(top_anomalies[['phenomenonTime', 'determinand_prefLabel', 'result', 'longitude', 'latitude']])


def map_anomalies():
    """Generates a spatial coordinates cluster map using standard pandas and matplotlib."""
    print("\n[*] Initialising spatial mapping engine...")
    
    try:
        # 1. Fetch data from SQLite
        conn = sqlite3.connect(DB_PATH)
        query = "SELECT longitude, latitude FROM water_anomalies"
        df = pd.read_sql_query(query, conn)
        conn.close()
        
        if df.empty:
            print("[!] No data found in database to map.")
            return

        # 2. Set up a standard matplotlib figure plot
        plt.figure(figsize=(10, 10))
        
        # 3. Fast coordinate plot
        plt.scatter(
            df['longitude'], 
            df['latitude'], 
            alpha=0.6, 
            s=25, 
            color='red', 
            edgecolors='darkred',
            linewidths=0.5,
            label='Contamination Anomaly'
        )
        
        # 4. Format labels & design
        plt.title("Midlands Water Intelligence Network\nSpatial Anomaly Clusters (1,239 Points)", fontsize=14, fontweight='bold')
        plt.xlabel("Longitude")
        plt.ylabel("Latitude")
        plt.grid(True, linestyle='--', alpha=0.5)
        
        # 5. Fixed systemic annotation point
        plt.annotate(
            'Systemic Hot Spot\n(-1.3702, 52.6434)', 
            xy=(-1.3702, 52.6434), 
            xytext=(-1.1, 52.8),
            arrowprops=dict(facecolor='black', shrink=0.08, width=1, headwidth=6),
            fontsize=10, 
            fontweight='bold',
            bbox=dict(boxstyle="round,pad=0.3", fc="yellow", alpha=0.8)
        )
        
        plt.legend(loc='upper right')
        plt.tight_layout()
        
        # 6. FORCE SAVE the image file straight to disk first
        output_image = os.path.join(DATA_DIR, "midlands_anomaly_map.png")
        plt.savefig(output_image, dpi=300)
        print(f"[+] Spatial map image asset saved to: {output_image}")
        
        # 7. Launch popup window
        print("[+] Rendering interactive spatial canvas window...")
        plt.show()
        
    except Exception as err:
        print(f"[-] Mapping Execution Engine Error: {str(err)}")


# Global control block running all scripts in sequential layout order
if __name__ == "__main__":
    run_etl()
    check_results()
    map_anomalies()
    
    """
